# Copy to .env and adjust. Never commit real keys.
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PASSWORD=sct_password

# Authentication (JWT). Generate each secret with:  openssl rand -hex 48
# They must be different from each other and at least 32 characters long.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access token lifetime (short) and refresh token lifetime (long).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Password of the seeded demo users (stored only as a bcrypt hash).
SEED_PASSWORD=ChangeMe123!

# Load demo data on first start (idempotent).
SEED_ON_START=true

# AI provider. Leave LLM_PROVIDER=heuristic to run fully offline.
LLM_PROVIDER=heuristic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
