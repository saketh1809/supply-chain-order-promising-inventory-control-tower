# Copy to .env and adjust. Never commit real keys.
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PASSWORD=sct_password

# Load demo data on first start (idempotent).
SEED_ON_START=true

# AI provider. Leave LLM_PROVIDER=heuristic to run fully offline.
LLM_PROVIDER=heuristic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
