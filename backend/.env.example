# ---- Server ----
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=log

# ---- Database (MySQL) ----
DATABASE_URL="mysql://sct:sct_password@localhost:3306/sct"
TEST_DATABASE_URL="mysql://sct:sct_password@localhost:3306/sct_test"

# ---- AI provider (never hardcode keys) ----
# LLM_PROVIDER: openai | anthropic | heuristic
#   heuristic = deterministic local fallback used when no key is configured
LLM_PROVIDER=heuristic
LLM_API_KEY=
LLM_MODEL=
# Only used for LLM_PROVIDER=openai (any OpenAI-compatible endpoint works)
LLM_BASE_URL=https://api.openai.com/v1
