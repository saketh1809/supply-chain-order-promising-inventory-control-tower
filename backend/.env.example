# ---- Server ----
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=log

# ---- Database (MySQL) ----
DATABASE_URL="mysql://sct:sct_password@localhost:3306/sct"
TEST_DATABASE_URL="mysql://sct:sct_password@localhost:3306/sct_test"

# ---- Authentication (JWT) ----
# Generate each secret with:  openssl rand -hex 48   (different values, at least 32 characters).
# In production (NODE_ENV=production) the server refuses to start without them.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m     # short-lived access token
JWT_REFRESH_TTL=7d     # long-lived refresh token (rotated on every use)
AUTH_RATE_LIMIT=10     # login/refresh attempts per window, per IP and e-mail
AUTH_RATE_WINDOW=60s
TRUST_PROXY=1          # number of reverse proxies in front of the API (Render = 1)
# Password given to the seeded demo users. Required when seeding a remote database.
SEED_PASSWORD=ChangeMe123!

# ---- AI provider (never hardcode keys) ----
# LLM_PROVIDER: openai | anthropic | heuristic
#   heuristic = deterministic local fallback used when no key is configured
LLM_PROVIDER=heuristic
LLM_API_KEY=
LLM_MODEL=
# Only used for LLM_PROVIDER=openai (any OpenAI-compatible endpoint works)
LLM_BASE_URL=https://api.openai.com/v1
